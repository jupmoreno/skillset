#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/rm-skill <local-skill-name> [local-skill-name ...]

Removes skills from skills/. Imported skills also have their source mappings
removed and unused vendor branches and upstream remotes pruned. This command
commits the removal without including unrelated worktree changes.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

safe_component() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid skill name: $1"
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'run this command inside your skills Git repository'
[[ $# -gt 0 ]] || { usage >&2; exit 2; }

for name in "$@"; do
  safe_component "$name"
done

for name in "$@"; do
  local_path="skills/$name"
  [[ -d "$local_path" ]] || die "skill directory does not exist: $local_path"
done

for name in "$@"; do
  if ! git diff --quiet -- "skills/$name" || ! git diff --cached --quiet -- "skills/$name"; then
    die "commit or stash changes to skills/$name before removing it"
  fi
done
if ! git diff --quiet -- .skillset/sources.tsv || ! git diff --cached --quiet -- .skillset/sources.tsv; then
  die 'commit or stash changes to .skillset/sources.tsv before removing a skill'
fi

removed_metadata="$(mktemp "${TMPDIR:-/tmp}/skillset-remove.XXXXXX")"
remaining_metadata="$(mktemp "${TMPDIR:-/tmp}/skillset-remaining.XXXXXX")"
trap 'rm -f "$removed_metadata" "$remaining_metadata"' EXIT

if [[ -f .skillset/sources.tsv ]]; then
  awk -F '\t' -v names="$(IFS=,; printf '%s' "$*")" '
    BEGIN { split(names, requested, ","); for (i in requested) remove["skills/" requested[i]] = 1 }
    /^#/ || NF == 0 { next }
    remove[$1] { print > removed; next }
    { print > remaining }
  ' removed="$removed_metadata" remaining="$remaining_metadata" .skillset/sources.tsv
fi

for name in "$@"; do
  rm -rf "skills/$name"
done

if [[ -s "$removed_metadata" && -s "$remaining_metadata" ]]; then
  {
    printf '# local_path\trepository\tref\tupstream_path\tremote\tvendor_branch\tupstream_commit\n'
    sort "$remaining_metadata"
  } > .skillset/sources.tsv
elif [[ -s "$removed_metadata" ]]; then
  rm .skillset/sources.tsv
fi

while IFS=$'\t' read -r _local_path _repo _ref _source_path remote branch; do
  [[ -z "$remote" ]] && continue
  git branch -D "$branch" >/dev/null 2>&1 || true
  if git remote get-url "$remote" >/dev/null 2>&1 && ! awk -F '\t' -v remote="$remote" '$1 !~ /^#/ && $5 == remote { found = 1 } END { exit !found }' "$remaining_metadata"; then
    git remote remove "$remote"
  fi
done < "$removed_metadata"

commit_paths=()
for name in "$@"; do
  commit_paths+=("skills/$name")
done
if git ls-files --error-unmatch .skillset/sources.tsv >/dev/null 2>&1; then
  commit_paths+=(.skillset/sources.tsv)
fi
git add -u -- "${commit_paths[@]}"
if [[ $# -eq 1 ]]; then
  git commit --only -m "Remove $1 skill" -- "${commit_paths[@]}"
  printf 'Removed skill: %s.\n' "$1"
else
  git commit --only -m 'Remove skills' -- "${commit_paths[@]}"
  printf 'Removed skills: %s.\n' "$*"
fi
