#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/sync-skill [local-skill-name ...]

Fetches the configured upstream source for each named skill and merges changes
from its recorded upstream directory. With no names, synchronizes every imported
skill listed in .skillset/sources.tsv.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

split_upstream_path() {
  local source_path="$1" remote="$2" ref="$3" split_worktree split_commit
  split_worktree="$(mktemp -d "${TMPDIR:-/tmp}/skillset-split.XXXXXX")"
  rmdir "$split_worktree"
  git worktree add --quiet --detach "$split_worktree" "$remote/$ref"
  if ! split_commit="$(git -C "$split_worktree" subtree split --prefix="$source_path")"; then
    git worktree remove --force "$split_worktree"
    return 1
  fi
  git worktree remove --force "$split_worktree"
  printf '%s\n' "$split_commit"
}

signed_commit_like() {
  local original_commit="$1" author_name author_email author_date
  shift
  author_name="$(git show -s --format=%an "$original_commit")"
  author_email="$(git show -s --format=%ae "$original_commit")"
  author_date="$(git show -s --format=%aI "$original_commit")"
  GIT_AUTHOR_NAME="$author_name" GIT_AUTHOR_EMAIL="$author_email" GIT_AUTHOR_DATE="$author_date" \
    git commit-tree "$(git rev-parse "$original_commit^{tree}")" -S "$@" -F <(git show -s --format=%B "$original_commit")
}

commit_signing_enabled() {
  [[ "$(git config --bool --get commit.gpgSign 2>/dev/null)" == true ]]
}

sign_squashed_subtree_merge() {
  local merge_commit="$1" parents signed_squash_commit signed_merge_commit
  read -r -a parents <<< "$(git show -s --format=%P "$merge_commit")"
  [[ ${#parents[@]} -eq 2 ]] || die "expected a squashed subtree merge commit: $merge_commit"

  # git subtree does not sign its synthetic squash parent, even with -S.
  signed_squash_commit="$(signed_commit_like "${parents[1]}")"
  signed_merge_commit="$(signed_commit_like "$merge_commit" -p "${parents[0]}" -p "$signed_squash_commit")"
  git update-ref HEAD "$signed_merge_commit" "$merge_commit"
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'run this command inside your skills Git repository'
git diff --quiet && git diff --cached --quiet || die 'commit or stash changes before syncing skills'
[[ -f .skillset/sources.tsv ]] || die 'no imported skills are registered in .skillset/sources.tsv'

sync_row() {
  local local_path="$1" repo="$2" ref="$3" source_path="$4" remote="$5" branch="$6" upstream_commit="$7"
  local skill_name="${local_path#skills/}" subtree_args=(--squash)
  local split_commit

  if [[ ${#requested[@]} -gt 0 ]]; then
    local wanted
    for wanted in "${requested[@]}"; do
      [[ "$wanted" == "$skill_name" ]] && break
    done
    [[ "${wanted:-}" == "$skill_name" ]] || return 0
  fi

  git remote get-url "$remote" >/dev/null 2>&1 || git remote add "$remote" "$repo"
  [[ "$(git remote get-url "$remote")" == "$repo" ]] || die "remote $remote no longer points at $repo"
  git fetch --no-tags "$remote" "$ref"
  git cat-file -e "$remote/$ref:$source_path" 2>/dev/null || die "upstream path no longer exists at $remote/$ref: $source_path"

  split_commit="$(split_upstream_path "$source_path" "$remote" "$ref")"
  [[ "$split_commit" == "$upstream_commit" ]] && {
    printf '%s is already up to date.\n' "$skill_name"
    return 0
  }

  git branch -f "$branch" "$split_commit"
  if commit_signing_enabled; then
    subtree_args+=(-S)
  fi
  git subtree pull "${subtree_args[@]}" --prefix="$local_path" -m "Sync $skill_name from $repo" . "$branch"
  if commit_signing_enabled; then
    sign_squashed_subtree_merge "$(git rev-parse HEAD)"
  fi

  awk -F '\t' -v OFS='\t' -v local_path="$local_path" -v upstream_commit="$split_commit" '
    /^#/ { print; next }
    $1 == local_path { $7 = upstream_commit }
    { print }
  ' .skillset/sources.tsv > .skillset/sources.tsv.tmp
  mv .skillset/sources.tsv.tmp .skillset/sources.tsv
  git add .skillset/sources.tsv
  git commit -m "Track $skill_name upstream revision"
  printf 'Synced upstream updates for %s.\n' "$skill_name"
}

requested=("$@")
if [[ "${requested[0]:-}" == '-h' || "${requested[0]:-}" == '--help' ]]; then
  usage
  exit 0
fi

matched=0
while IFS=$'\t' read -r local_path repo ref source_path remote branch upstream_commit; do
  [[ -z "$local_path" || "$local_path" == \#* ]] && continue
  if [[ ${#requested[@]} -eq 0 ]]; then
    matched=1
  else
    for wanted in "${requested[@]}"; do
      [[ "$wanted" == "${local_path#skills/}" ]] && matched=1
    done
  fi
  [[ -n "$upstream_commit" ]] || upstream_commit="$(git rev-parse "$branch")"
  sync_row "$local_path" "$repo" "$ref" "$source_path" "$remote" "$branch" "$upstream_commit"
done < .skillset/sources.tsv

[[ $matched -eq 1 ]] || die "none of the requested skills are registered"
