#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  bin/import-skill <github-tree-url> [local-skill-name]
  bin/import-skill --repo <git-url> --ref <branch-or-tag> --path <directory> [--name <local-skill-name>]

Imports one directory from an upstream Git repository into skills/<local-skill-name>
with a Git subtree merge commit. The upstream source is recorded in
.skillset/sources.tsv for later updates with bin/sync-skill.

When fm or apfel is available, the importer also checks the upstream SKILL.md
for explicit references to other skills in that repository. It prints the
full dependency tree and asks before importing any missing skills.

Examples:
  bin/import-skill https://github.com/mattpocock/skills/tree/main/skills/engineering/grill-with-docs
  bin/import-skill --repo https://github.com/acme/skills.git --ref main \
    --path skills/review --name acme-review
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_clean_worktree() {
  git diff --quiet && git diff --cached --quiet || die 'commit or stash changes before importing a skill'
}

safe_component() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid skill name: $1"
}

safe_path() {
  [[ "$1" != /* && "$1" != *$'\t'* && "$1" != *$'\n'* && "$1" != *".."* ]] || die "invalid path: $1"
}

split_upstream_path() {
  local path="$1" split_worktree split_commit
  split_worktree="$(mktemp -d "${TMPDIR:-/tmp}/skillset-split.XXXXXX")"
  rmdir "$split_worktree"
  git worktree add --quiet --detach "$split_worktree" "$remote/$ref"
  if ! split_commit="$(git -C "$split_worktree" subtree split --prefix="$path")"; then
    git worktree remove --force "$split_worktree"
    return 1
  fi
  git worktree remove --force "$split_worktree"
  printf '%s\n' "$split_commit"
}

build_skill_catalog() {
  local catalog_file="$1" manifest_path manifest name

  git ls-tree -r --name-only "$remote/$ref" | while IFS= read -r manifest_path; do
    [[ "$manifest_path" == */SKILL.md || "$manifest_path" == SKILL.md ]] || continue
    manifest="$(git show "$remote/$ref:$manifest_path")"
    name="$(printf '%s\n' "$manifest" | awk '
      /^---[[:space:]]*$/ { delimiters++; next }
      delimiters == 1 && $1 == "name:" {
        sub(/^[[:space:]]*name:[[:space:]]*/, "")
        gsub(/^["\047]|["\047]$/, "")
        print
        exit
      }
      delimiters >= 2 { exit }
    ')"
    [[ -n "$name" ]] || name="${manifest_path%/SKILL.md}"
    name="${name##*/}"
    printf '%s\t%s\n' "$name" "${manifest_path%/SKILL.md}"
  done | sort -u > "$catalog_file"
}

detect_referenced_skills() {
  local primary_path="$1" source_file catalog_file response_file prompt
  source_file="$(mktemp "${TMPDIR:-/tmp}/skillset-source.XXXXXX")"
  catalog_file="$(mktemp "${TMPDIR:-/tmp}/skillset-catalog.XXXXXX")"
  response_file="$(mktemp "${TMPDIR:-/tmp}/skillset-references.XXXXXX")"
  if ! git show "$remote/$ref:$primary_path/SKILL.md" > "$source_file" 2>/dev/null; then
    rm -f "$source_file" "$catalog_file" "$response_file"
    return 0
  fi
  build_skill_catalog "$catalog_file"
  if [[ ! -s "$catalog_file" ]]; then
    rm -f "$source_file" "$catalog_file" "$response_file"
    return 0
  fi

  prompt='Analyze the attached source skill and skill catalog. Identify every distinct other skill that the source explicitly instructs an agent to load, call, invoke, or delegate to. Do not infer topical relationships. Return only skill names from the catalog, one per line. Exclude the source skill itself. Return NONE if there are no explicit references.'
  if command -v fm >/dev/null 2>&1; then
    if ! { printf 'SOURCE SKILL:\n'; cat "$source_file"; printf '\nSKILL CATALOG:\n'; cat "$catalog_file"; } | fm "$prompt" > "$response_file"; then
      printf 'warning: fm could not inspect skill references; importing only the requested skill.\n' >&2
      rm -f "$source_file" "$catalog_file" "$response_file"
      return 0
    fi
  elif command -v apfel >/dev/null 2>&1; then
    if ! apfel --quiet --temperature 0 --max-tokens 512 -f "$source_file" -f "$catalog_file" "$prompt" > "$response_file"; then
      printf 'warning: apfel could not inspect skill references; importing only the requested skill.\n' >&2
      rm -f "$source_file" "$catalog_file" "$response_file"
      return 0
    fi
  else
    rm -f "$source_file" "$catalog_file" "$response_file"
    return 0
  fi

  while IFS=$'\t' read -r catalog_name catalog_path; do
    [[ "$catalog_path" != "$primary_path" ]] || continue
    if awk -v name="$catalog_name" '$0 == name { found = 1 } END { exit !found }' "$response_file"; then
      printf '%s\t%s\n' "$catalog_name" "$catalog_path"
    fi
  done < "$catalog_file"
  rm -f "$source_file" "$catalog_file" "$response_file"
}

skill_name_for_path() {
  awk -F '\t' -v path="$1" '$2 == path { print $1; exit }' "$skill_catalog"
}

skill_state_for_path() {
  awk -F '\t' -v path="$1" '$1 == path { print $2; exit }' "$dependency_state"
}

set_skill_state() {
  local path="$1" state="$2"
  awk -F '\t' -v OFS='\t' -v path="$path" -v state="$state" '
    $1 == path { next }
    { print }
    END { print path, state }
  ' "$dependency_state" > "$dependency_state.tmp"
  mv "$dependency_state.tmp" "$dependency_state"
}

render_dependency_tree() {
  local path="$1" prefix="$2" connector="$3" root="$4"
  local skill_name state child_prefix references_file child_name child_path count index marker

  skill_name="$(skill_name_for_path "$path")"
  [[ -n "$skill_name" ]] || return 0
  state="$(skill_state_for_path "$path")"
  if [[ "$state" == visiting ]]; then
    printf '%s%s%s [cycle]\n' "$prefix" "$connector" "$skill_name"
    return 0
  fi
  if [[ "$state" == done ]]; then
    printf '%s%s%s [shared]\n' "$prefix" "$connector" "$skill_name"
    return 0
  fi

  marker=''
  [[ -e "skills/$skill_name" ]] && marker=' [installed]'
  printf '%s%s%s%s\n' "$prefix" "$connector" "$skill_name" "$marker"
  set_skill_state "$path" visiting

  references_file="$(mktemp "${TMPDIR:-/tmp}/skillset-children.XXXXXX")"
  detect_referenced_skills "$path" > "$references_file"
  count="$(wc -l < "$references_file" | tr -d ' ')"
  index=0
  if [[ -z "$connector" ]]; then
    child_prefix="$prefix"
  elif [[ "$connector" == '`- ' ]]; then
    child_prefix="${prefix}   "
  else
    child_prefix="${prefix}|  "
  fi
  while IFS=$'\t' read -r child_name child_path; do
    [[ -n "$child_path" ]] || continue
    index=$((index + 1))
    if [[ "$index" -eq "$count" ]]; then
      render_dependency_tree "$child_path" "$child_prefix" '`- ' false
    else
      render_dependency_tree "$child_path" "$child_prefix" '+- ' false
    fi
  done < "$references_file"
  rm -f "$references_file"

  set_skill_state "$path" done
  if [[ "$root" == false && ! -e "skills/$skill_name" ]]; then
    printf '%s\t%s\n' "$skill_name" "$path" >> "$dependency_candidates"
  fi
}

import_skill() {
  local skill_name="$1" skill_path="$2" destination split_commit branch
  safe_component "$skill_name"
  safe_path "$skill_path"
  destination="skills/$skill_name"

  if [[ -e "$destination" ]]; then
    printf 'Skipping %s: already present at %s.\n' "$skill_name" "$destination"
    return 0
  fi
  if [[ -f .skillset/sources.tsv ]] && awk -F '\t' -v destination="$destination" '$1 == destination { found = 1 } END { exit found ? 0 : 1 }' .skillset/sources.tsv; then
    die "source metadata already exists for: $destination"
  fi
  git cat-file -e "$remote/$ref:$skill_path" 2>/dev/null || die "upstream path does not exist at $remote/$ref: $skill_path"

  branch="vendor/$remote-$skill_name"
  split_commit="$(split_upstream_path "$skill_path")"
  git branch -f "$branch" "$split_commit"
  git subtree add --prefix="$destination" -m "Import $skill_name from $repo" . "$branch"

  mkdir -p .skillset
  if [[ ! -f .skillset/sources.tsv ]]; then
    printf '# local_path\trepository\tref\tupstream_path\tremote\tvendor_branch\tupstream_commit\n' > .skillset/sources.tsv
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$destination" "$repo" "$ref" "$skill_path" "$remote" "$branch" "$split_commit" >> .skillset/sources.tsv
  git add .skillset/sources.tsv
  git commit -m "Track $skill_name upstream source"
  printf 'Imported %s into %s.\n' "$skill_path" "$destination"
}

repo=''
ref=''
source_path=''
name=''

if [[ $# -ge 1 && "$1" != --* ]]; then
  tree_url="$1"
  shift
  [[ $# -le 1 ]] || { usage >&2; exit 2; }
  name="${1:-}"

  prefix='https://github.com/'
  [[ "$tree_url" == "$prefix"* && "$tree_url" == */tree/* ]] || die 'tree URL must be a GitHub https://github.com/<owner>/<repo>/tree/<ref>/<path> URL'
  remainder="${tree_url#"$prefix"}"
  repository_part="${remainder%%/tree/*}"
  tail="${remainder#*/tree/}"
  [[ "$repository_part" == */* && "$tail" == */* ]] || die "invalid GitHub tree URL: $tree_url"
  repo="https://github.com/${repository_part}.git"

  # GitHub ref names may contain '/', so find the longest matching remote branch.
  while IFS=$'\t' read -r _sha remote_ref; do
    candidate="${remote_ref#refs/heads/}"
    if [[ "$tail" == "$candidate/"* ]] && (( ${#candidate} > ${#ref} )); then
      ref="$candidate"
      source_path="${tail#"$candidate"/}"
    fi
  done < <(git ls-remote --heads "$repo")
  [[ -n "$ref" && -n "$source_path" ]] || die "could not resolve a branch and directory from: $tree_url"
else
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="${2:-}"; shift 2 ;;
      --ref) ref="${2:-}"; shift 2 ;;
      --path) source_path="${2:-}"; shift 2 ;;
      --name) name="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
fi

[[ -n "$repo" && -n "$ref" && -n "$source_path" ]] || { usage >&2; exit 2; }
safe_path "$source_path"
name="${name:-${source_path##*/}}"
safe_component "$name"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'run this command inside your skills Git repository'
git rev-parse --verify HEAD >/dev/null 2>&1 || die 'create an initial commit before importing a skill'
require_clean_worktree

destination="skills/$name"
[[ ! -e "$destination" ]] || die "destination already exists: $destination"
[[ ! -f .skillset/sources.tsv ]] || ! awk -F '\t' -v destination="$destination" '$1 == destination { found = 1 } END { exit !found }' .skillset/sources.tsv || die "source metadata already exists for: $destination"

remote_stub="${repo#*://}"
remote_stub="${remote_stub#*@}"
remote_stub="${remote_stub%.git}"
remote_stub="${remote_stub//\//-}"
remote_stub="${remote_stub//[^A-Za-z0-9._-]/-}"
remote="skill-source-$remote_stub"

if git remote get-url "$remote" >/dev/null 2>&1; then
  [[ "$(git remote get-url "$remote")" == "$repo" ]] || die "remote name is already used for a different URL: $remote"
else
  git remote add "$remote" "$repo"
fi

git fetch --no-tags "$remote" "$ref"
git cat-file -e "$remote/$ref:$source_path" 2>/dev/null || die "upstream path does not exist at $remote/$ref: $source_path"

skill_catalog="$(mktemp "${TMPDIR:-/tmp}/skillset-catalog.XXXXXX")"
dependency_state="$(mktemp "${TMPDIR:-/tmp}/skillset-dependencies.XXXXXX")"
dependency_candidates="$(mktemp "${TMPDIR:-/tmp}/skillset-candidates.XXXXXX")"
trap 'rm -f "$skill_catalog" "$dependency_state" "$dependency_state.tmp" "$dependency_candidates"' EXIT
build_skill_catalog "$skill_catalog"

printf 'Upstream skill dependency tree:\n'
render_dependency_tree "$source_path" '' '' true

if [[ -s "$dependency_candidates" ]]; then
  printf 'Import all missing referenced skills? [y/N] '
  read -r import_references || die 'could not read the referenced-skill import response'
fi

import_skill "$name" "$source_path"
if [[ "${import_references:-}" =~ ^[Yy]([Ee][Ss])?$ ]]; then
  while IFS=$'\t' read -r referenced_name referenced_path; do
    import_skill "$referenced_name" "$referenced_path"
  done < "$dependency_candidates"
fi
trap - EXIT
rm -f "$skill_catalog" "$dependency_state" "$dependency_state.tmp" "$dependency_candidates"
printf 'Run bin/sync-skill %s to merge future upstream changes.\n' "$name"
